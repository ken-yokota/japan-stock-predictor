# Copy this file to .env. Never commit the real .env file.
# Yahoo Finance and the official US Treasury feed do not require API keys.

# Optional: enables the quota-limited EODHD Free fallback/verification route.
EODHD_API_KEY=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/japan_stock_predictor
RESEND_API_KEY=
EMAIL_FROM=predictions@example.com
EMAIL_TO=you@example.com
APP_URL=http://localhost:8501
TIMEZONE=Asia/Tokyo

# Optional Phase 1 tuning. Provider quotas/freshness are enforced by
# config/settings.yaml.
EODHD_BASE_URL=https://eodhd.com/api
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
