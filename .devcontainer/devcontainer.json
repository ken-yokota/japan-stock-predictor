{
  "name": "Python 3.14",
  // The Microsoft devcontainer images stop at 3.13, so this uses the official
  // Python image instead. The version is not a preference: pyproject.toml sets
  // requires-python = ">=3.14", so `pip install -e .` fails outright on
  // anything older, and this repository deliberately runs one interpreter
  // everywhere (commit 7aaa794) after a period when four were in use and the
  // deployed dashboard was the one build no test had touched.
  "image": "python:3.14-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && apt-get update && xargs apt-get install -y <packages.txt; pip3 install -e .; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}